---
import { getCollection, getEntry } from 'astro:content';
import BaseLayout from '@layouts/BaseLayout.astro';
import Introduction from '@components/Introduction.astro';
import SelectedWork from '@components/SelectedWork.astro';
import ProcessStrip from '@components/ProcessStrip.astro';
import FeatureQuote from '@components/FeatureQuote.astro';
import Testimonials from '@components/Testimonials.astro';
import CTABand from '@components/CTABand.astro';
import { byOrder } from '../lib/content';

const site = await getEntry('settings', 'site');
const home = await getEntry('pages', 'home');
const testimonials = byOrder(await getCollection('testimonials'));
const services = byOrder(await getCollection('services'));
const featuredServices = services.slice(0, 4);

const hero = home?.data.hero;
const projects = home?.data.gallery;

/* Use Gail and Linda's testimonial — strongest and most detailed quote. */
const featureTestimonial = testimonials.find((t) => t.id === 'gail-linda') ?? testimonials[0];
---

<BaseLayout>
  <!-- ── Hero: full-bleed background image, minimal overlay, nav overlaid ── -->
  <section class="home-hero">
    <div
      class="home-hero__bg"
      style="background-image: url('/melbourne-plastering/uploads/hero-plastering.jpg')"
      aria-hidden="true"
    ></div>
    <div class="home-hero__blur" aria-hidden="true"></div>
    <div class="home-hero__overlay" aria-hidden="true"></div>
    <div class="home-hero__inner container grid-12">
      <div class="home-hero__content">
        <p class="home-hero__eyebrow hero-enter hero-enter--eyebrow">30 years of master craftsmanship</p>
        <h1 class="home-hero__h1">{hero?.title ?? 'Master craftsmanship in every finish.'}</h1>
        <p class="home-hero__intro hero-enter hero-enter--intro">{hero?.intro ?? 'Heritage & residential plastering throughout Melbourne.'}</p>
        <div class="home-hero__actions hero-enter hero-enter--actions">
          <a class="home-hero__button" href={hero?.primaryUrl ?? '/contact/'}>
            {hero?.primaryLabel ?? 'Free quote'} &rarr;
          </a>
          <a class="home-hero__button-secondary" href="/services/">
            Our services &rarr;
          </a>
        </div>
      </div>
    </div>
    <div class="home-hero__scroll hero-enter hero-enter--scroll" aria-hidden="true">&darr;</div>
  </section>

  <!-- ── Trust bar: quick stats ── -->
  <section class="trust-strip">
    <div class="container trust-strip__inner">
      <div class="trust-strip__item">
        <span class="trust-strip__number">30</span>
        <span class="trust-strip__label">Years experience</span>
      </div>
      <div class="trust-strip__item">
        <span class="trust-strip__number">1000+</span>
        <span class="trust-strip__label">Projects completed</span>
      </div>
      <div class="trust-strip__item">
        <span class="trust-strip__number">Melbourne</span>
        <span class="trust-strip__label">Service area</span>
      </div>
      <div class="trust-strip__item">
        <span class="trust-strip__number">Free</span>
        <span class="trust-strip__label">Quotes &amp; inspections</span>
      </div>
    </div>
  </section>

  <!-- ── Introduction: two-column editorial statement ── -->
  <section class="about-intro surface">
    <div class="container grid-12">
      <div class="about-intro__heading">
        <p class="eyebrow">About Mark Dennerley</p>
        <h2>A master craftsman who treats every project like his own.</h2>
      </div>
      <div class="about-intro__body">
        <p>Mark Dennerley, owner of Melbourne Plastering &amp; Building Maintenance, brings a unique blend of 30 years experience, artistic creativity, and practical design skills to every project.</p>
        <p>He takes on each project as if it were his own — with your best interest at heart. Mark strives for perfection and excellence in whatever he works on. His keen eye for detail and skills have earned him respect from customers and fellow tradesmen alike, who often refer to him as a master craftsman.</p>
        <p>At Melbourne Plastering &amp; Building Maintenance, we've been providing solutions for customers' needs for 30 years. We love what we do — and we do it well.</p>
        <a href="/contact/" class="button">Get a free quote &rarr;</a>
      </div>
    </div>
  </section>

  <!-- ── Services: 4 image tiles ── -->
  <section class="services-inline">
    <div class="container">
      <p class="section-heading">OUR SERVICES</p>

      <div class="services-inline__track grid-12">
        {featuredServices.map((service, i) => (
          <a href={`/services/${service.id}/`} class="services-inline__item">
            <div class="services-inline__image-wrap">
              <div class="services-inline__icon" aria-hidden="true">
                {['🏠', '🏛️', '🏢', '🔧'][i]}
              </div>
            </div>
            <div class="services-inline__label-block">
              <span class="services-inline__label">{service.data.title}</span>
              <p class="services-inline__description">{service.data.summary}</p>
            </div>
          </a>
        ))}
      </div>
    </div>
  </section>

  <!-- ── Process: simple 3-step ── -->
  <section class="process-strip surface" id="process">
    <div class="container">
      <p class="section-heading">HOW IT WORKS</p>
      <div class="process-strip__track grid-12">
        <div class="process-strip__step">
          <span class="process-strip__number">01</span>
          <h3 class="process-strip__title">Free quote &amp; inspection</h3>
          <p class="process-strip__text">We visit your site, assess the work, and provide a clear, no-obligation quote.</p>
        </div>
        <div class="process-strip__step">
          <span class="process-strip__number">02</span>
          <h3 class="process-strip__title">Expert execution</h3>
          <p class="process-strip__text">Mark and the team deliver precision work on schedule, with minimal disruption to your home.</p>
        </div>
        <div class="process-strip__step">
          <span class="process-strip__number">03</span>
          <h3 class="process-strip__title">Flawless finish</h3>
          <p class="process-strip__text">Every surface is cleaned, checked, and finished to the highest standard — guaranteed.</p>
        </div>
      </div>
    </div>
  </section>

  <!-- ── Testimonials ── -->
  <Testimonials testimonials={testimonials} />

  <!-- ── Contact CTA ── -->
  <section class="cta-contact">
    <div class="container cta-contact__inner">
      <h2 class="cta-contact__title">Ready to get started?</h2>
      <p class="cta-contact__text">Contact Mark for a free quote or to discuss your project. No obligation, just honest advice from a master craftsman.</p>
      <div class="cta-contact__details">
        <a href="tel:0419992210" class="cta-contact__phone">0419 992 210</a>
        <a href="mailto:mark@melbourneplastering.com.au" class="cta-contact__email">mark@melbourneplastering.com.au</a>
      </div>
      <a href="/contact/" class="button cta-contact__button">Request a free quote &rarr;</a>
    </div>
  </section>
</BaseLayout>

<style is:global>
  /* ═══════════════════════════════════════════════
     Hero — full-bleed background, nav overlaid
     ═══════════════════════════════════════════════ */

  .home-hero {
    position: relative;
    display: flex;
    align-items: center;
    min-height: 100vh;
    overflow: hidden;
    background: var(--color-overlay-strong);
  }

  .home-hero__bg {
    position: absolute;
    inset: -8% 0;
    background-position: center 35%;
    background-size: cover;
    background-repeat: no-repeat;
    background-attachment: fixed;
    z-index: 0;
    transform-origin: center center;
    animation: hero-bg-breathe 2s cubic-bezier(0.22, 1, 0.36, 1) both;
  }

  @keyframes hero-bg-breathe {
    from { transform: scale(1.07); }
    to   { transform: scale(1); }
  }

  .home-hero__blur {
    position: absolute;
    inset: 0;
    z-index: 1;
    -webkit-backdrop-filter: blur(5px);
    backdrop-filter: blur(5px);
    -webkit-mask-image: linear-gradient(
      to right,
      black 0%,
      black 35%,
      transparent 70%,
      transparent 100%
    );
    mask-image: linear-gradient(
      to right,
      black 0%,
      black 35%,
      transparent 70%,
      transparent 100%
    );
    pointer-events: none;
  }

  .home-hero__overlay {
    position: absolute;
    inset: 0;
    background: linear-gradient(
      to right,
      rgba(26, 42, 58, 0.55) 0%,
      rgba(26, 42, 58, 0.2) 50%,
      rgba(26, 42, 58, 0.05) 75%
    );
    z-index: 2;
    animation: hero-overlay-in 1.4s ease both;
  }

  @keyframes hero-overlay-in {
    from { opacity: 0.3; }
    to   { opacity: 1; }
  }

  .home-hero__inner {
    position: relative;
    z-index: 2;
    width: min(100% - (var(--gutter) * 2), var(--container));
  }

  .home-hero__content {
    grid-column: 1 / span 6;
  }

  .home-hero__eyebrow {
    font-size: 0.78rem;
    font-weight: 600;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--brand-accent);
    margin-bottom: var(--space-4);
  }

  .home-hero__content h1 {
    font-weight: 500;
    font-size: var(--text-3xl);
    line-height: var(--line-tight);
    color: #ffffff;
    margin-bottom: var(--space-5);
    opacity: 0;
  }

  .home-hero__intro {
    font-size: clamp(1rem, 2vw, 1.2rem);
    color: rgba(255, 255, 255, 0.75);
    max-width: 34rem;
    margin-bottom: var(--space-6);
    line-height: 1.75;
  }

  .home-hero__actions {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-3);
  }

  .home-hero__button-secondary {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    padding: 0.9rem 1.1rem 0.9rem 1.25rem;
    background: transparent;
    color: #ffffff;
    font-weight: 500;
    font-size: var(--text-base);
    text-transform: uppercase;
    letter-spacing: 0.04em;
    text-decoration: none;
    border: 1px solid rgba(255, 255, 255, 0.35);
    line-height: 1;
    transition: border-color 0.2s ease;
  }

  .home-hero__button-secondary:hover {
    border-color: #ffffff;
  }

  .home-hero__button {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    padding: 0.9rem 1.1rem 0.9rem 1.25rem;
    background: var(--brand-accent);
    color: #ffffff;
    font-weight: 500;
    font-size: var(--text-base);
    text-decoration: none;
    line-height: 1;
    text-transform: uppercase;
    letter-spacing: 0.04em;
    transition: filter 0.2s ease;
  }

  .home-hero__button:hover {
    filter: brightness(1.1);
  }

  .home-hero__scroll {
    position: absolute;
    bottom: 2rem;
    left: 50%;
    transform: translateX(-50%);
    z-index: 3;
    font-size: 1.25rem;
    color: rgba(255, 255, 255, 0.4);
    pointer-events: none;
  }

  @keyframes hero-enter {
    from {
      opacity: 0;
      transform: translateY(36px);
    }
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }

  @keyframes hero-scroll-appear-bounce {
    0%   { opacity: 0; transform: translateX(-50%) translateY(0); }
    20%  { opacity: 1; transform: translateX(-50%) translateY(0); }
    60%  { opacity: 1; transform: translateX(-50%) translateY(7px); }
    100% { opacity: 1; transform: translateX(-50%) translateY(0); }
  }

  .hero-enter {
    opacity: 0;
    animation: hero-enter 0.9s cubic-bezier(0.22, 1, 0.36, 1) both;
  }

  .hero-enter--eyebrow { animation-delay: 0.35s; }
  .hero-enter--intro   { animation-delay: 0.55s; }
  .hero-enter--actions { animation-delay: 0.8s; }
  .hero-enter--scroll {
    animation: hero-scroll-appear-bounce 3.2s cubic-bezier(0.22, 1, 0.36, 1) 1.4s both;
    animation-iteration-count: infinite;
  }

  @media (max-width: 820px) {
    .home-hero__bg {
      background-attachment: scroll;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .home-hero__bg {
      animation: none;
      transform: none;
      background-attachment: scroll;
    }
    .home-hero__overlay {
      animation: none;
    }
    .home-hero__h1 {
      opacity: 1;
    }
    .hero-enter {
      animation: none;
      opacity: 1;
    }
  }

  body:has(.home-hero) .site-header {
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    z-index: 20;
    border-bottom: none;
    background: transparent;
  }

  body:has(.home-hero) .site-header__logo-text {
    color: #ffffff;
  }

  body:has(.home-hero) .site-header__logo-accent {
    color: rgba(255, 255, 255, 0.8);
  }

  body:has(.home-hero) .site-header__nav a {
    color: #ffffff !important;
  }

  body:has(.home-hero) .site-header__nav a:hover,
  body:has(.home-hero) .site-header__nav a[aria-current='page'] {
    color: rgba(255, 255, 255, 0.7) !important;
  }

  body:has(.home-hero) .site-header__cta {
    color: #ffffff !important;
  }

  body:has(.home-hero) .site-header__cta:hover {
    filter: brightness(1.1);
    color: #ffffff !important;
  }

  /* ═══════════════════════════════════════════════
     Trust Strip — quick stats
     ═══════════════════════════════════════════════ */

  .trust-strip {
    padding-block: var(--space-6);
    border-bottom: 1px solid var(--color-border);
  }

  .trust-strip__inner {
    display: flex;
    justify-content: space-around;
    gap: var(--space-4);
    flex-wrap: wrap;
  }

  .trust-strip__item {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 0.25rem;
  }

  .trust-strip__number {
    font-size: 1.5rem;
    font-weight: 700;
    color: var(--brand-primary);
    line-height: 1.1;
  }

  .trust-strip__label {
    font-size: 0.78rem;
    color: var(--color-text-muted);
    text-transform: uppercase;
    letter-spacing: 0.06em;
  }

  /* ═══════════════════════════════════════════════
     About Introduction
     ═══════════════════════════════════════════════ */

  .about-intro {
    padding-block: var(--section-y);
  }

  .about-intro__heading {
    grid-column: 1 / span 5;
  }

  .about-intro__heading h2 {
    font-size: clamp(1.75rem, 3.5vw, 2.5rem);
    font-weight: 500;
    margin: 0;
  }

  .about-intro__body {
    grid-column: 7 / span 6;
  }

  .about-intro__body p {
    margin-bottom: var(--space-5);
    font-size: var(--text-md);
  }

  .about-intro__body .button {
    margin-top: var(--space-4);
    background: var(--brand-accent);
    color: #fff;
    border-color: var(--brand-accent);
  }

  /* ═══════════════════════════════════════════════
     Services — 4 tiles
     ═══════════════════════════════════════════════ */

  .services-inline {
    padding-block: var(--section-y);
  }

  .services-inline__track {
    row-gap: var(--space-6);
  }

  .services-inline__item {
    grid-column: span 3;
    display: block;
    text-decoration: none;
    color: inherit;
  }

  .services-inline__image-wrap {
    background: var(--color-soft);
    aspect-ratio: 4 / 3;
    display: flex;
    align-items: center;
    justify-content: center;
    overflow: hidden;
  }

  .services-inline__icon {
    font-size: 3rem;
    line-height: 1;
  }

  .services-inline__label-block {
    background: var(--color-soft);
    padding: 0.9rem 1rem;
  }

  .services-inline__label {
    display: block;
    font-size: 1.1rem;
    font-weight: 500;
    color: var(--color-heading);
    margin-bottom: 0.25rem;
  }

  .services-inline__description {
    font-size: 0.85rem;
    color: var(--color-text-muted);
    margin: 0;
    line-height: 1.5;
  }

  .services-inline__item:hover .services-inline__image-wrap {
    background: color-mix(in srgb, var(--color-soft), var(--brand-primary) 8%);
  }

  /* ═══════════════════════════════════════════════
     Process Strip — 3 steps
     ═══════════════════════════════════════════════ */

  .process-strip {
    padding-block: var(--section-y);
  }

  .process-strip__track {
    gap: var(--space-6);
  }

  .process-strip__step {
    grid-column: span 4;
    padding: var(--space-6);
    background: var(--color-page);
    border-radius: var(--radius-md);
  }

  .process-strip__number {
    font-size: 2.5rem;
    font-weight: 700;
    color: var(--brand-primary);
    opacity: 0.15;
    line-height: 1;
    display: block;
    margin-bottom: var(--space-4);
  }

  .process-strip__title {
    font-size: 1.15rem;
    font-weight: 600;
    margin-bottom: var(--space-3);
    color: var(--color-heading);
  }

  .process-strip__text {
    font-size: var(--text-sm);
    color: var(--color-text-muted);
    margin: 0;
  }

  /* ═══════════════════════════════════════════════
     CTA Contact
     ═══════════════════════════════════════════════ */

  .cta-contact {
    padding-block: var(--section-y);
    background: var(--brand-primary);
    color: #ffffff;
    text-align: center;
  }

  .cta-contact__title {
    font-size: clamp(2rem, 4vw, 3rem);
    font-weight: 500;
    color: #ffffff;
    margin-bottom: var(--space-4);
  }

  .cta-contact__text {
    font-size: var(--text-md);
    color: rgba(255, 255, 255, 0.75);
    max-width: 36rem;
    margin: 0 auto var(--space-6);
  }

  .cta-contact__details {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: var(--space-2);
    margin-bottom: var(--space-6);
  }

  .cta-contact__phone {
    font-size: 1.75rem;
    font-weight: 700;
    color: #ffffff;
    text-decoration: none;
    letter-spacing: -0.02em;
  }

  .cta-contact__phone:hover {
    color: var(--brand-accent);
  }

  .cta-contact__email {
    font-size: 1rem;
    color: rgba(255, 255, 255, 0.7);
    text-decoration: none;
  }

  .cta-contact__email:hover {
    color: #ffffff;
  }

  .cta-contact__button {
    background: var(--brand-accent);
    color: #ffffff;
    border-color: var(--brand-accent);
    font-size: var(--text-base);
    padding: 1rem 1.5rem;
  }

  .cta-contact__button:hover {
    filter: brightness(1.1);
  }

  .cta-contact__inner {
    display: flex;
    flex-direction: column;
    align-items: center;
  }

  /* ═══════════════════════════════════════════════
     Responsive overrides
     ═══════════════════════════════════════════════ */

  @media (max-width: 900px) {
    .home-hero__content {
      grid-column: 1 / span 7;
    }

    .about-intro__heading,
    .about-intro__body {
      grid-column: 1 / -1;
    }

    .about-intro__heading {
      margin-bottom: var(--space-5);
    }

    .services-inline__item {
      grid-column: span 6;
    }

    .process-strip__step {
      grid-column: span 6;
    }
  }

  @media (max-width: 600px) {
    .home-hero__content,
    .services-inline__item,
    .process-strip__step {
      grid-column: 1;
    }

    .home-hero__content {
      max-width: 100%;
    }

    .home-hero__content h1 {
      font-size: clamp(2.5rem, 12vw, 3.5rem);
      overflow-wrap: anywhere;
    }

    .home-hero__intro {
      font-size: var(--text-base);
    }

    .trust-strip__inner {
      display: grid;
      grid-template-columns: 1fr 1fr;
      gap: var(--space-4);
      text-align: center;
    }
  }
</style>
