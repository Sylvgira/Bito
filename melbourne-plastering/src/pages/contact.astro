---
import { getEntry } from 'astro:content';
import BaseLayout from '@layouts/BaseLayout.astro';
import PageIntro from '@components/PageIntro.astro';
import Section from '@components/Section.astro';
import ContactBlock from '@components/ContactBlock.astro';

const site = await getEntry('settings', 'site');
---

<BaseLayout title="Contact" description="Get in touch with Melbourne Plastering & Building Maintenance for a free quote. Heritage and residential plastering across Melbourne.">
  <PageIntro
    eyebrow="Contact"
    title="Start with a conversation"
    intro="Contact Mark for a free quote or to discuss your project. He'll take the guesswork out of your next plastering or maintenance job."
  />

  <Section>
    <ContactBlock
      email={site?.data.email}
      phone={site?.data.phone}
      address={site?.data.address}
    />
  </Section>

  <Section variant="surface" narrow>
    <div class="prose">
      <h3>Service area</h3>
      <p>We service all areas of Melbourne. If you're not sure whether we cover your suburb, just ask — we probably do.</p>
      <p><strong>Phone:</strong> <a href="tel:0419992210">0419 992 210</a></p>
      <p><strong>Email:</strong> <a href="mailto:mark@melbourneplastering.com.au">mark@melbourneplastering.com.au</a></p>
    </div>
  </Section>
</BaseLayout>
