#!/usr/bin/env sh
set -eu

password_file="${BW_PASSWORD_FILE:-$HOME/.config/openclaw/bw-master-password}"
password_dir="$(dirname "$password_file")"

mkdir -p "$password_dir"
umask 077

if [ ! -t 0 ]; then
  echo "bw-password-store must be run from an interactive terminal" >&2
  exit 1
fi

printf 'Bitwarden master password: ' >&2
stty_state="$(stty -g)"
trap 'stty "$stty_state" 2>/dev/null || true' EXIT INT TERM HUP
stty -echo
IFS= read -r password
stty "$stty_state"
trap - EXIT INT TERM HUP
printf '\n' >&2

printf '%s\n' "$password" > "$password_file"
chmod 600 "$password_file"
unset password

echo "Stored Bitwarden password for automatic unlock." >&2
