#!/usr/bin/env sh
set -eu

service="${BW_KEYCHAIN_SERVICE:-openclaw-bitwarden-master-password}"
account="${BW_KEYCHAIN_ACCOUNT:-sylvaingirard.bito@gmail.com}"
bw_path="$(command -v bw)"

if [ -z "${bw_path:-}" ]; then
  echo "bw not found on PATH" >&2
  exit 1
fi

if [ ! -t 0 ]; then
  echo "bw-keychain-store must be run from an interactive terminal" >&2
  exit 1
fi

printf 'Bitwarden master password: ' >&2
stty_state="$(stty -g)"
trap 'stty "$stty_state" 2>/dev/null || true' EXIT INT TERM HUP
stty -echo
IFS= read -r password
stty "$stty_state"
trap - EXIT INT TERM HUP
printf '\n' >&2

security add-generic-password \
  -U \
  -A \
  -s "$service" \
  -a "$account" \
  -w "$password" \
  -T "$bw_path" \
  -T /usr/bin/security >/dev/null

unset password
echo "Stored Bitwarden password in Keychain for future automatic unlocks." >&2
