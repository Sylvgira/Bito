#!/usr/bin/env sh
set -eu

password_file="${BW_PASSWORD_FILE:-$HOME/.config/openclaw/bw-master-password}"

# Function to securely read password from file
get_password_from_file() {
  if [ -r "$password_file" ]; then
    cat "$password_file"
    return 0
  else
    echo "Error: Bitwarden master password file not found or not readable: $password_file" >&2
    exit 1
  fi
}

# Get the master password from the file
master_password=$(get_password_from_file)

# Unlock Bitwarden using the master password read from the file
# The --passwordenv BW_PASSWORD tells bw to look for the password in the BW_PASSWORD environment variable.
# We set BW_PASSWORD for this specific command only, using the 'master_password' variable.
session="$(BW_PASSWORD="$master_password" /Users/sylvaingirard/.nvm/versions/node/v22.22.3/bin/bw unlock --raw --passwordenv BW_PASSWORD)"

# Unset the master password from memory for security after use
unset master_password

# Emit shell code for the caller to eval into the current session.
# This will set the BW_SESSION environment variable.
printf 'export BW_SESSION=%s\\n' "$session"